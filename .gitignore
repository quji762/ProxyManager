# Build artifacts
dist/
build/
*.spec
__pycache__/
*.pyc

# Config (user preferences plus a DPAPI-encrypted restore stash — treat as
# sensitive, like the .bak; never commit)
config.json
config.json.bak
config.json.corrupt
config.json.*.tmp
config.json.lock

# Crash / trace logs written by the app at runtime
*.log

# Test / lint caches
.pytest_cache/
.ruff_cache/

# IDE
.vscode/
.idea/
.zcode/

# OS
Thumbs.db
Desktop.ini
*.lnk
