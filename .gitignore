# Build artifacts
dist/
build/
*.spec
__pycache__/
*.pyc

# Config (user preferences plus a DPAPI-encrypted restore stash — treat as
# sensitive, like the .bak; never commit)
config.json
config.json.bak
config.json.corrupt
config.json.*.tmp
config.json.lock

# Crash / trace logs written by the app at runtime
*.log

# Test / lint caches
.pytest_cache/
.ruff_cache/

# IDE
.vscode/
.idea/
.zcode/

# OS
Thumbs.db
Desktop.ini
*.lnk

# Local secrets and accidental data-dir copies. Runtime config already lives
# under %APPDATA%; these keep a checkout from picking up env files, stray
# backups, or a backups/ folder created next to the source tree.
.env
.env.*
*.bak
backups/
